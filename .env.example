# FaceBook configuration file for Meta Pulse project
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
GRAPH_API_VERSION=v23.0

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_USE_GOOGLE_SEARCH_GROUNDING=true
GEMINI_TOPIC_PROMPT="You are a senior content strategist for a Facebook Page. Today's date: {DATE}. Niche: {NICHE}. Pick a genuinely interesting subject. Rules: Never repeat covered topics: {RECENT_TOPICS}. Never touch banned subjects: {BANNED_TOPICS}. Headline style: {HEADLINE_STYLE}. Respond with ONLY raw JSON matching this shape: {JSON_SHAPE}"

# Content Niche & Rules
CONTENT_NICHE=Artificial Intelligence and Tech Trends
CONTENT_BANNED_TOPICS=Crypto scams, Get rich quick schemes, Unverified medical claims
CONTENT_MONETIZATION_SAFE_MODE=true

# Image Configuration
IMAGE_HEADLINE_MAX_CHARACTERS=60

# History & Logging Configuration
HISTORY_FILE_PATH=./logs/history.json
HISTORY_KEEP_LAST_N=50
LOGGING_FILE_PATH=./logs/app.log
LOGGING_TO_FILE=true