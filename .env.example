# FaceBook Configuration
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_NAME="Your Brand"
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
GRAPH_API_VERSION=v23.0
FACEBOOK_POST_TO_STORY=true

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_USE_GOOGLE_SEARCH_GROUNDING=true
GEMINI_TOPIC_PROMPT="You are a senior content strategist for a Facebook Page. Today's date: {DATE}. Niche: {NICHE}. Pick a genuinely interesting subject. Rules: Never repeat covered topics: {RECENT_TOPICS}. Never touch banned subjects: {BANNED_TOPICS}. Headline style: {HEADLINE_STYLE}. Respond with ONLY raw JSON matching this shape: {JSON_SHAPE}"

# Content Niche & Rules
CONTENT_NICHE="Artificial Intelligence and Tech Trends"
CONTENT_BANNED_TOPICS="Crypto scams, Get rich quick schemes, Unverified medical claims"
CONTENT_MONETIZATION_SAFE_MODE=true
CONTENT_TONE="Informative, engaging, and professional"
CONTENT_LANGUAGE="English"
CONTENT_GOALS="Build authority, Provide value"

# Image Configuration
IMAGE_HEADLINE_MAX_CHARACTERS=60
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_PROMPT_TEMPLATE="A high-quality, professional photo illustrating: {{TOPIC}}. {{VISUAL_HINT}}"

# Output Configuration
OUTPUT_IMAGE_PATH=./final_post.png

# Caption Configuration
CAPTION_CALL_TO_ACTION_OPTIONS="What do you think?, Let me know in the comments!"
CAPTION_BANNED_PHRASES="click here, buy now"
CAPTION_INCLUDE_CALL_TO_ACTION=true
CAPTION_MIN_PARAGRAPHS=2
CAPTION_MAX_PARAGRAPHS=4
CAPTION_HASHTAG_COUNT=3
CAPTION_FIXED_HASHTAGS="#AI, #TechTrends"

# Reliability Configuration
RELIABILITY_REQUEST_TIMEOUT_MS=30000

# History & Logging Configuration
HISTORY_FILE_PATH=./logs/history.json
HISTORY_KEEP_LAST_N=50
LOGGING_FILE_PATH=./logs/app.log
